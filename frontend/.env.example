# ── Local development ───────────────────────────────────────────────────────
# Copy this file to .env.local and edit as needed (.env.local is gitignored).
# Vite loads .env.local automatically when running `npm run dev`.

VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=SIS-KYRO-REFACTOR

# ── Production (Docker) ─────────────────────────────────────────────────────
# The production URL is baked into the Docker image via a build ARG.
# Default in Dockerfile: VITE_API_BASE_URL=https://refactor.kyrocodelabs.cloud/api
# Override with:  docker build --build-arg VITE_API_BASE_URL=https://your-api.example.com/api

# ── App nativa Android (Capacitor) ──────────────────────────────────────────
# El build nativo (`npm run build:android`) usa .env.capacitor, no este archivo.
# Ver .env.capacitor para la VITE_API_BASE_URL de producción usada por la app.

# ── Flag de emergencia: terminal web (DECISION-APP-02) ─────────────────────
# Cuando la app Android reemplace al terminal web en todas las tiendas, poner
# en 'false' para ocultar /terminal en el navegador (queda solo la app nativa).
# Default: true (terminal web sigue activo). NO cambiar a 'false' todavia.
VITE_TERMINAL_WEB_HABILITADO=true
