APP_NAME="SIS-KYRO-REFACTOR"
APP_ENV=production
APP_KEY=
QR_SECRET_KEY=
APP_DEBUG=false
APP_URL=https://refactor.kyrocodelabs.cloud

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
ATTENDANCE_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# En producción usa "error" para no volcar info/debug al disco.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=your-private-db-host
DB_PORT=3306
DB_DATABASE=migracion
DB_USERNAME=db_user
DB_PASSWORD=your_strong_password_here

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.kyrocodelabs.cloud

# CORS: orígenes permitidos (coma-separados). La SPA usa withCredentials, por lo que
# NO se admite '*'; lista explícita de dominios del frontend.
CORS_ALLOWED_ORIGINS=https://app.kyrocodelabs.cloud

# Sanctum: expiración de tokens en minutos (default 14 días = 20160). Los expirados se
# purgan a diario con "sanctum:prune-expired" (scheduler en routes/console.php).
SANCTUM_EXPIRATION=20160

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# En Dokploy el host Redis es el nombre del servicio del stack (ej. "redis").
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Prefijos para aislar este proyecto si comparte Redis con otros stacks.
REDIS_PREFIX=siskyro_
CACHE_PREFIX=siskyro_cache_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="sistema@siskyro.pe"
MAIL_FROM_NAME="${APP_NAME}"

# Integrador Bitel (agente extractor local). Debe coincidir con el config.php
# de los agentes desplegados en las tiendas.
INTEGRADOR_API_KEY=

SUNAT_RUC=20123456789
SUNAT_USUARIO_SOL=USUARIO
SUNAT_CLAVE_SOL=CLAVE
# Cambiar a "produccion" cuando se active el certificado real.
SUNAT_ENV=beta
SUNAT_CERT_PATH=/var/certs/empresa.pfx
SUNAT_CERT_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
